# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Windows PowerShell:  Copy-Item .env.example .env

# --- Firebase Firestore (service account JSON path or ADC) ---
# Download from: Firebase Console > Project settings > Service accounts
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json
FIRESTORE_PROJECT_ID=your-firebase-project-id
FIRESTORE_DATABASE_URL=(default)

# --- Hugging Face Inference API ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=distilbert-base-uncased-finetuned-sst-2-english
HF_API_URL=https://api-inference.huggingface.co/models
# Neutral band: |P(pos)-P(neg)| below this => label "neutral"
NEUTRAL_THRESHOLD=0.15

# --- Processing limits (free-tier friendly) ---
MAX_REVIEWS=200
REQUEST_TIMEOUT_S=20
REQUEST_PAUSE_S=0.5

# --- Dashboard ---
APP_ENV=development
# Set when deployed on Streamlit Community Cloud (secrets.toml used there instead)
